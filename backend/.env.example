APP_NAME=file-text-parser
ENV=development
# ⚠ true 会启用 uvicorn reload：文件一变就重启 serve 子进程，连同 worker 线程一起杀掉，
# 导致任务永久卡在处理中。生产/日常调试建议 false。
DEBUG=false

HOST=0.0.0.0
PORT=8000

API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

MAX_UPLOAD_SIZE_MB=50
KEEP_UPLOADED_FILES=false

OCR_LANG=chi_sim+eng
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_DPI=300
PDF_OCR_FALLBACK=true

# 流水线 worker：随后端自动后台挂载，消费文件任务队列
# false = 关闭自动挂载（此时需自行运行 python worker.py run）
WORKER_ENABLED=true
WORKER_IDLE_SECONDS=3
WORKER_SHUTDOWN_TIMEOUT=10

# LLM-to-Text 工具（多模态大模型识别图片文字，OpenAI 兼容接口）
# 留空 = 未启用；填写后 /tools/llm-to-text 才可用。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=60
# worker 提取兜底：OCR 平均置信度低于阈值时裁块交 LLM 重认（需 LLM_API_KEY）
LLM_FALLBACK_ENABLED=true
LLM_CONFIDENCE_THRESHOLD=0.8
